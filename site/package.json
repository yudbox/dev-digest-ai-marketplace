{
  "name": "dev-digest-ai-marketplace-site",
  "private": true,
  "version": "0.1.0",
  "description": "Static catalog of the dev-digest-ai-marketplace plugins, deployed to GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "index": "node ../scripts/build-index.mjs --root .. --out public",
    "index:demo": "node ../scripts/build-index.mjs --root test/fixtures/demo-marketplace --out public",
    "dev": "npm run index && vite",
    "dev:demo": "npm run index:demo && vite",
    "build": "npm run index && tsc --noEmit && vite build",
    "build:demo": "npm run index:demo && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "markdown-it": "^14.1.0",
    "minisearch": "^7.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^2.1.9"
  }
}
